<CaseStudy
  title="Governing AI to untangle"
  accent="complex fintech workflows."
  subtitle="Transforming 30 raw spreadsheet requirements into a dual-role credit management prototype in 7 days."
  role="Product Designer · Information Architecture, AI-Assisted Prototyping, MVP Scoping"
  domain="Fintech products & B2B financial operations · Credit management"
  timeline="1-week sprint · Executive client demo"
  year="2026"
  tools="FigJam · VS Code + Claude Code · Design System"
  visual="fintech"
  gated={true}
  iaComparison={true}
