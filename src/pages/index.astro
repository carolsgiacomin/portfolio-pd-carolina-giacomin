---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-meta">
          <span>Product Designer · Milan / Remote</span>
        </div>
        <h1 id="hero-title">Complex workflows,<br /><em>made intuitive.</em></h1>
        <p class="hero-copy">I design software for complex, rule-heavy work in finance, education, and legal.</p>
        <div class="hero-actions">
          <a class="text-link" href="#work">View projects <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="hero-visual" aria-hidden="true">
        <img src="/images/Cover-Fintech.png" alt="" fetchpriority="high" />
        <span class="hero-callout hero-callout--one">Structured workflows</span>
        <span class="hero-callout hero-callout--two">Clear decisions</span>
      </figure>
    </div>
  </section>

  <section class="section section--work" id="work" aria-labelledby="work-heading">
    <div class="section-heading">
      <h2 id="work-heading" class="section-index">Selected Work</h2>
      <p class="eyebrow">Case studies · 2021–2026</p>
    </div>
    <div class="project-grid">
      <ProjectCard title="Fintech · Credit workflows" context="Fintech" year="2026" outcome="Reframed 30 requirements into a role-based credit workflow prototype in one week." href="/work/fintech-products/" visual="fintech" badge="NDA protected" />
      <ProjectCard title="Legal operations · Knowledge base" context="Legal operations" year="2019–2020" outcome="Made high-priority issuance rules easier to find and maintain." href="/work/docket-atlas/" visual="legal" />
      <ProjectCard title="Healthcare · Multilingual access" context="Healthcare" year="MSc project" outcome="Connected multilingual patients and clinicians across the care journey." href="/work/guido/" visual="health" />
      <ProjectCard title="AI Art Archive · MSc thesis" context="Information design" year="2021–2024" outcome="Made a fragmented media debate navigable across data and editorial formats." href="/work/ai-art-archive/" visual="archive" />
    </div>
  </section>

  <section class="section capabilities" id="capabilities" aria-labelledby="capabilities-heading">
    <div class="section-heading">
      <h2 id="capabilities-heading" class="section-index">Focus &amp; Practice</h2>
    </div>
    <div class="practice-index">
      <article class="practice-item">
        <h3>Product Systems &amp; Workflows</h3>
        <p>I turn dense rules, fragmented tools, and high-stakes processes into clear products people can use with confidence. I stay close to real constraints, partnering with product and engineering from early scoping through delivery.</p>
        <p class="practice-example">I map dense rules and fragmented tools into processes people can trust.</p>
      </article>
      <article class="practice-item">
        <h3>Information Architecture</h3>
        <p>I make complex products easier to understand by clarifying roles, navigation, and the relationships between tasks. The goal is the right information, in the right context, so people can move through their work without losing the thread.</p>
        <p class="practice-example">I clarify roles, navigation, and task relationships so people find the right information in the right context.</p>
      </article>
      <article class="practice-item">
        <h3>Research &amp; Data Visualization</h3>
        <p>I combine user research and data thinking to find useful patterns, test assumptions, and make dense information easier to scan. My background in data visualization helps turn evidence into interfaces that support better decisions.</p>
        <p class="practice-example">I combine research and data thinking to surface patterns that make dense information easy to scan.</p>
      </article>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-heading">
    <h2 class="section-index" id="about-heading">About</h2>
    <div class="about-grid">
    <figure class="about-portrait">
      <img class="about-photo" src="/images/carolina_giacomin.JPG" alt="Carolina Giacomin" />
      <figcaption class="portrait-caption">Carolina Giacomin · Milan, Italy</figcaption>
    </figure>
      <div class="about-copy">
        <h2 class="about-title">From São Paulo to Milan: bridging product logic and visual clarity.</h2>
        <p>My path into product design started in São Paulo, studying Industrial Design at the University of São Paulo (FAU-USP) and building early-stage B2B SaaS products and design systems. Seeking a deeper lens on how people make sense of complex information, I moved to Milan to complete my MSc in Communication Design at Politecnico di Milano—working alongside data visualization pioneers at Accurat before joining a fintech team to design complex financial workflows.</p>
        <p>I keep an illustration practice that helps me explore ideas through shape and color. I also run Jacomin, my side brand, and work on design systems that help teams build consistent products.</p>
        <div class="about-details">
          <div class="about-detail">
            <span>Education</span>
            <p>Master of Science (MSc) in Communication Design · Politecnico di Milano<br />Bachelor of Design · University of São Paulo (FAU-USP)</p>
          </div>
          <div class="about-detail">
            <span>Languages</span>
            <p>Italian · English · Portuguese</p>
          </div>
          <div class="about-detail">
            <span>Currently</span>
            <p>Product Designer · Fintech</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-cta" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Let's talk about complex systems.</h2>
    <a class="button button-primary" href="mailto:carolsgiacomin@gmail.com">Get in touch</a>
  </section>
</SiteLayout>
