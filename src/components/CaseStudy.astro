---
import SiteLayout from "../layouts/SiteLayout.astro";
import InformationArchitectureComparison from "./InformationArchitectureComparison.astro";
import CardSortingMatrix from "./CardSortingMatrix.astro";
import DocketBeforeAfter from "./DocketBeforeAfter.astro";
import ServiceBlueprint from "./ServiceBlueprint.astro";
import FintechNdaGallery from "./FintechNdaGallery.astro";

interface Props {
  title: string;
  accent?: string;
  subtitle: string;
  role: string;
  timeline: string;
  team?: string;
  impact?: string;
  domain?: string;
  year?: string;
  tools?: string;
  metadata?: { label: string; value: string }[];
  visual: "fintech" | "legal" | "health" | "archive";
  gated?: boolean;
  comparison?: boolean;
  context?: string;
  approach?: string;
  outcome?: string;
  iaComparison?: boolean;
  cardSortingMatrix?: boolean;
  docketComparison?: boolean;
  serviceBlueprint?: boolean;
  fintechGallery?: boolean;
  sections?: {
    heading: string;
    paragraphs: string[];
    items?: { title: string; description: string }[];
  }[];
}

const {
  title, accent, subtitle, role, timeline, team, impact, visual,
  domain, year, tools, metadata, gated = false, comparison = false, iaComparison = false,
  cardSortingMatrix = false, docketComparison = false, serviceBlueprint = false,
  fintechGallery = false, context, approach, outcome, sections,
} = Astro.props;
const pageTitle = `${title} — Case Study | Carolina Giacomin`;
const caseSections = sections ?? [];
const coverImage = visual === "fintech"
  ? "/images/Cover-Fintech.png"
  : visual === "health"
    ? "/images/guido-ui-overview_final.png"
    : undefined;
---

<SiteLayout title={pageTitle} description={subtitle}>
  <article>
    <header class="case-hero">
      <a class="back-link" href="/#work">← Back to selected work</a>
      <div class="eyebrow">Case study</div>
      <h1 class="case-title">{title}{accent && <> <em>{accent}</em></>}</h1>
      <p class="case-intro">{subtitle}</p>
      <div class="case-meta-grid">
        {metadata ? metadata.map((item) => (
          <div class="case-meta-item"><span class="eyebrow">{item.label}</span><span>{item.value}</span></div>
        )) : (
          <>
            <div class="case-meta-item"><span class="eyebrow">Role</span><span>{role}</span></div>
            <div class="case-meta-item"><span class="eyebrow">{domain ? "Domain" : "Timeline"}</span><span>{domain ?? timeline}</span></div>
            <div class="case-meta-item"><span class="eyebrow">{domain ? "Timeline" : "Team"}</span><span>{domain ? timeline : team}</span></div>
            <div class="case-meta-item"><span class="eyebrow">{tools ? "Tools" : "Impact"}</span><span>{tools ?? impact}</span></div>
          </>
        )}
      </div>
    </header>

    {gated && (
      <section class="password-panel" aria-labelledby="password-title">
        <p class="eyebrow">Confidential project</p>
        <h2 id="password-title">This case study is password protected.</h2>
        <p>Enter the access password to view the project overview.</p>
        <form class="password-form" id="case-password-form">
          <label class="sr-only" for="case-password">Password</label>
          <input id="case-password" name="password" type="password" autocomplete="current-password" required />
          <button type="submit">Unlock case study</button>
        </form>
        <p class="form-message" id="password-message" role="status" aria-live="polite"></p>
      </section>
    )}

    <div id="case-content" hidden={gated}>
      <section class="case-feature" aria-label="Product interface preview">
        {comparison ? (
          <>
            <div class="project-visual">
              <span class="visual-index">Before &amp; after</span>
              <div class="comparison" id="comparison">
                <div class="comparison-panel comparison-panel--before">
                  <p class="eyebrow">Before</p><h2 class="comparison-title">Scattered information</h2>
                  <div class="comparison-columns">
                    <div class="comparison-box comparison-lines"><span></span><span></span><span></span><span></span><span></span></div>
                    <div class="comparison-box comparison-lines"><span></span><span></span><span></span><span></span><span></span><span></span></div>
                  </div>
                </div>
                <div class="comparison-panel comparison-panel--after">
                  <p class="eyebrow">After</p><h2 class="comparison-title">A connected knowledge base</h2>
                  <div class="comparison-columns">
                    <div class="comparison-box comparison-lines"><span></span><span></span><span></span><span></span><span></span></div>
                    <div class="comparison-box comparison-lines"><span></span><span></span><span></span><span></span><span></span><span></span></div>
                  </div>
                </div>
                <div class="comparison-divider" aria-hidden="true"></div>
                <input class="comparison-range" id="comparison-range" type="range" min="0" max="100" value="50" aria-label="Compare before and after designs" aria-valuetext="50 percent after" />
              </div>
              <div class="comparison-labels" aria-hidden="true"><span>Before</span><span>After</span></div>
            </div>
          </>
        ) : (
          <div class={`project-visual ${visual}-visual`} aria-hidden="true">
            <span class="visual-index">Product preview</span>
            {gated && <span class="nda-badge">NDA protected</span>}
            {coverImage && <img class="project-cover" src={coverImage} alt="" loading="lazy" decoding="async" />}
            <div class={`product-window ${visual}-window`}>
              <div class="window-top"><span>{visual === "fintech" ? "Fintech Products" : visual === "health" ? "Guido / Care" : "AI Art Archive"}</span><span>Workspace · Overview</span></div>
              {visual === "fintech" && <div class="window-body"><div class="window-sidebar"><i class="ui-line accent"></i><i class="ui-line"></i><i class="ui-line short"></i><i class="ui-line"></i><i class="ui-line medium"></i></div><div class="window-content"><i class="ui-heading"></i><i class="ui-line medium"></i><div class="ui-table">{[1, 2, 3, 4].map(() => <div class="ui-table-row"><i class="ui-line"></i><i class="ui-line"></i><i class="ui-line"></i></div>)}</div></div></div>}
              {visual === "health" && <div class="window-body"><div class="window-content"><div><i class="ui-heading"></i><i class="ui-line medium"></i><i class="ui-line"></i><i class="ui-line short"></i></div><div class="health-orb">+</div></div></div>}
              {visual === "archive" && <div class="window-body"><div class="window-content">{[1, 2, 3, 4, 5, 6].map(() => <i class="archive-tile"></i>)}</div></div>}
            </div>
          </div>
        )}
      </section>
      {fintechGallery && <FintechNdaGallery />}

      {sections ? sections.map((section, sectionIndex) => (
        <section class="case-content" id={`case-section-${sectionIndex + 1}`}>
          <h2>{section.heading.replace(/^\d+\s*\/\s*/, "")}</h2>
          <div class="case-story">
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.items && (
              <ul class="case-decision-list">
                {section.items.map((item) => (
                  <li><strong>{item.title}</strong><span>{item.description}</span></li>
                ))}
              </ul>
            )}
            {iaComparison && sectionIndex === 1 && <InformationArchitectureComparison />}
            {cardSortingMatrix && sectionIndex === 1 && <CardSortingMatrix />}
            {serviceBlueprint && sectionIndex === 2 && <ServiceBlueprint />}
            {docketComparison && sectionIndex === 2 && <DocketBeforeAfter />}
          </div>
        </section>
      )) : (
        <>
          <section class="case-content">
            <h2>The context</h2>
            <div><p>{context}</p></div>
          </section>
          <section class="case-content">
            <h2>The approach</h2>
            <div><p>{approach}</p></div>
          </section>
          <section class="case-content">
            <h2>The outcome</h2>
            <div><p>{outcome}</p></div>
          </section>
        </>
      )}
    </div>
  </article>

  <script>
    const passwordForm = document.querySelector<HTMLFormElement>("#case-password-form");
    const passwordInput = document.querySelector<HTMLInputElement>("#case-password");
    const passwordMessage = document.querySelector<HTMLElement>("#password-message");
    const caseContent = document.querySelector<HTMLElement>("#case-content");
    const acceptedPasswords = new Set(["FINTECH2026", "BANKING2026"]);

    passwordForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!passwordInput || !passwordMessage || !caseContent) return;
      if (acceptedPasswords.has(passwordInput.value.trim().toUpperCase())) {
        caseContent.hidden = false;
        passwordForm.closest(".password-panel")?.setAttribute("hidden", "");
        caseContent.scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        passwordMessage.textContent = "That password didn't match. Please try again.";
        passwordInput.select();
      }
    });

    const comparison = document.querySelector<HTMLElement>("#comparison");
    const comparisonRange = document.querySelector<HTMLInputElement>("#comparison-range");

    comparisonRange?.addEventListener("input", () => {
      const value = comparisonRange.value;
      comparison?.style.setProperty("--split", `${value}%`);
      comparisonRange.setAttribute("aria-valuetext", `${value} percent after`);
    });
  </script>
</SiteLayout>
