    border-radius: 6px;
    background: var(--white);
  }

  .mock-window--active {
    border-color: var(--accent);
  }

  .mock-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    padding: 16px;
