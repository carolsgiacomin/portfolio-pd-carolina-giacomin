</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-docket-comparison]").forEach((widget) => {
    const buttons = Array.from(widget.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(widget.querySelectorAll<HTMLElement>("[data-panel]"));
    const status = widget.querySelector<HTMLElement>("[data-status]");

    const selectView = (view: string, focus = false) => {
      buttons.forEach((button) => {
        const selected = button.dataset.view === view;
        button.setAttribute("aria-selected", String(selected));
        button.tabIndex = selected ? 0 : -1;
        button.classList.toggle("ba-btn--active", selected);
        if (selected && focus) button.focus();
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== view;
      });

      if (status) {
        status.textContent = view === "before"
          ? "Showing: legacy nested tabs (high friction)"
          : "Showing: flattened dashboard + granular editing";
      }
    };

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => selectView(button.dataset.view ?? "after"));
      button.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
          event.preventDefault();
          const direction = event.key === "ArrowRight" ? 1 : -1;
          const next = (index + direction + buttons.length) % buttons.length;
          selectView(buttons[next].dataset.view ?? "after", true);
        } else if (event.key === "Home" || event.key === "End") {
          event.preventDefault();
          const target = event.key === "Home" ? buttons[0] : buttons[buttons.length - 1];
          selectView(target.dataset.view ?? "after", true);
        }
      });
    });

    selectView("after");
  });
</script>
