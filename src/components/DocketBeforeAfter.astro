    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .mock-edit-pill {
    flex: 0 0 auto;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--white);
    padding: 8px;
    color: var(--ink);
    font: inherit;
    font-size: 10px;
    cursor: pointer;
  }

  .mock-edit-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .mock-card-text {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
  }

  .mock-kv-list {
    display: flex;
    flex-direction: column;
