  }

  .mock-badge {
    border-radius: 3px;
    padding: 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
  }

  .mock-badge--warn {
    background: #fef3c7;
    color: #92400e;
  }

  .mock-badge--ok {
    background: #f5e6e3;
    color: var(--accent);
  }

  .mock-legacy-tabs {
    display: flex;
    overflow-x: auto;
