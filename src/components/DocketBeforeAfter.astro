    margin-bottom: 24px;
  }

  .comparison-eyebrow {
    margin: 0 0 8px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .comparison-header h3 {
    margin: 0 0 8px;
    font-size: clamp(19px, round(nearest, 2.3vw, 1px), 26px);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .comparison-header > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .ba-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .ba-toggle-group {
    display: inline-flex;
    gap: 8px;
    border-radius: 6px;
    background: #e5e2dc;
    padding: 8px;
  }

  .ba-btn {
    border: 0;
    border-radius: 4px;
    background: transparent;
    padding: 8px;
    color: var(--muted);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }

  .ba-btn[aria-selected="true"] {
    background: var(--white);
